{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe de evaluación — trabajo final",
  "description": "Salida canónica del agente evaluador. Todos los campos son obligatorios y se emiten siempre en este orden. Un campo sin contenido va vacío, nunca se omite.",
  "version": "1.15",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_rubrica",
    "fecha_evaluacion",
    "repositorio",
    "estado",
    "alerta",
    "inventario",
    "afirmaciones",
    "cruces_realizados",
    "dimensiones",
    "banderas",
    "penalizaciones",
    "puntaje_bruto",
    "puntaje_final",
    "nota_10",
    "sugerencia_mejora",
    "nota_al_margen",
    "dudas",
    "auditoria",
    "revision_humana_requerida",
    "firma"
  ],
  "properties": {
    "version_rubrica": {
      "type": "string",
      "const": "1.15",
      "description": "Versión de rubrica.md aplicada. Fija la trazabilidad del criterio."
    },
    "fecha_evaluacion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "repositorio": {
      "type": "string",
      "description": "URL o ruta evaluada, tal como se recibió."
    },
    "estado": {
      "type": "string",
      "enum": [
        "evaluado",
        "evaluado_con_reservas",
        "integridad_comprometida",
        "fuera_de_alcance",
        "no_evaluable"
      ]
    },
    "alerta": {
      "type": "string",
      "description": "Vacío normalmente. Se llena sólo con hallazgos que van en la primera línea del informe (G8: key expuesta)."
    },
    "inventario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formato_entrada",
        "raiz_efectiva",
        "archivos_raiz",
        "config_agentes_hallada",
        "archivos_leidos",
        "archivos_faltantes",
        "commits",
        "evidencia"
      ],
      "properties": {
        "formato_entrada": {
          "type": "string",
          "enum": [
            "repositorio_git",
            "zip",
            "carpeta",
            "otro"
          ],
          "description": "Paso 0.5 de la pasada 1. La materia admite el repositorio y el .zip: ambos son formatos legitimos."
        },
        "raiz_efectiva": {
          "type": "string",
          "description": "La carpeta que contiene el README estandar, relativa a lo recibido. \".\" si es el nivel superior. Toda la estructura obligatoria se juzga relativa a esta ruta, no al nivel superior."
        },
        "archivos_raiz": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relativos a la raiz efectiva."
        },
        "config_agentes_hallada": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paso 0 de la pasada 1: archivos de configuracion de agentes encontrados DENTRO del repositorio evaluado (AGENTS.md, CLAUDE.md, .cursorrules, .github/copilot-instructions.md...). Se declaran siempre, aunque el array quede vacio: un inventario que no los menciona es un inventario que no los busco."
        },
        "archivos_leidos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "archivos_faltantes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "De los exigidos por la estructura obligatoria: README.md, prompts/, corridas/, DECISIONES.md"
        },
        "commits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accesible",
            "cantidad",
            "rango_fechas",
            "autores"
          ],
          "properties": {
            "accesible": {
              "type": "boolean"
            },
            "cantidad": {
              "type": "integer",
              "minimum": 0
            },
            "rango_fechas": {
              "type": "string"
            },
            "autores": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidencia": {
          "type": "array",
          "description": "Registro de evidencia construido en la pasada 1. Toda cita del informe referencia un id de acá.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "archivo",
              "ubicacion",
              "cita"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]+$"
              },
              "archivo": {
                "type": "string"
              },
              "ubicacion": {
                "type": "string",
                "description": "Sección, línea o bloque."
              },
              "cita": {
                "type": "string",
                "maxLength": 200,
                "description": "Textual, hasta 25 palabras."
              }
            }
          }
        }
      }
    },
    "afirmaciones": {
      "type": "array",
      "description": "Pasada 2. Toda afirmación evaluable del README/DECISIONES contra su artefacto.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "afirmacion",
          "estado",
          "evidencia",
          "comentario"
        ],
        "properties": {
          "afirmacion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "VERIFICADA",
              "PARCIAL",
              "NO_VERIFICADA",
              "CONTRADICHA"
            ]
          },
          "evidencia": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            }
          },
          "comentario": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "cruces_realizados": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "description": "La bateria de cruces de la pasada 2. Los siete se reportan SIEMPRE, tambien cuando no encuentran nada: un cruce sin reportar es indistinguible de un cruce no hecho, y esa es la causa documentada de la inestabilidad D-13.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "que_se_cruzo",
          "resultado",
          "detalle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7"
            ]
          },
          "que_se_cruzo": {
            "type": "string"
          },
          "resultado": {
            "type": "string",
            "enum": [
              "sin_hallazgo",
              "hallazgo",
              "no_aplicable"
            ]
          },
          "detalle": {
            "type": "string",
            "maxLength": 400,
            "description": "Con hallazgo: que se encontro y que bandera disparo. Sin hallazgo: que se comparo concretamente. 'no_aplicable' exige decir por que."
          }
        }
      }
    },
    "dimensiones": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Siempre las cinco, siempre en orden D1..D5.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "peso",
          "requisitos",
          "nivel_base",
          "compuerta_aplicada",
          "nivel",
          "puntos",
          "justificacion",
          "que_falta_para_el_nivel_siguiente"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "nombre": {
            "type": "string"
          },
          "peso": {
            "type": "integer",
            "enum": [
              30,
              25,
              15
            ]
          },
          "requisitos": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "cumple",
                "evidencia",
                "motivo"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^R[1-5]\\.[1-4]$"
                },
                "cumple": {
                  "type": "boolean"
                },
                "evidencia": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]+$"
                  },
                  "description": "Obligatorio y no vacío cuando cumple = true. Chequeo A1."
                },
                "motivo": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          },
          "nivel_base": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "Cantidad de requisitos cumplidos, ajustada por la exigencia extra de nivel 4."
          },
          "compuerta_aplicada": {
            "type": "string",
            "description": "Vacío si ninguna. Si aplicó, se nombra: 'R1.2 = NO -> D1 <= 2'."
          },
          "nivel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "puntos": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "justificacion": {
            "type": "string",
            "minLength": 40,
            "maxLength": 800,
            "description": "2 a 4 oraciones, cada afirmación pegada a un id de evidencia."
          },
          "que_falta_para_el_nivel_siguiente": {
            "type": "string",
            "minLength": 15,
            "maxLength": 400,
            "description": "NUNCA vacio, ni siquiera en nivel 4. Es lo unico del informe que le llega al alumno: una sola accion concreta, en menos de 25 palabras. En nivel 4 se dice que sostiene el nivel."
          }
        }
      }
    },
    "banderas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "evidencia",
          "cita_textual",
          "efecto",
          "puntos"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "G1",
              "G2",
              "G3a",
              "G3b",
              "G3c",
              "G3d",
              "G4",
              "G5",
              "G6",
              "G7",
              "G8"
            ]
          },
          "nombre": {
            "type": "string"
          },
          "evidencia": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            }
          },
          "cita_textual": {
            "type": "string",
            "maxLength": 400,
            "description": "Lo hallado, transcripto tal cual. Obligatorio para G3."
          },
          "estado": {
            "type": "string",
            "enum": [
              "confirmada",
              "mencionada"
            ],
            "description": "Solo para G3. 'mencionada' = el texto hostil esta citado como dato que el trabajo analiza, y cumple las tres condiciones de la regla de la mencion (banderas.md G3). Si falta, se lee 'confirmada': la duda va hacia la lectura estricta."
          },
          "efecto": {
            "type": "string",
            "description": "El efecto tipificado en rubrica.md 1. Ej: 'se ignora como instruccion; -10'."
          },
          "puntos": {
            "type": "number",
            "maximum": 0,
            "description": "Negativo o 0. G5 siempre 0."
          }
        }
      }
    },
    "penalizaciones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detalle",
        "total"
      ],
      "properties": {
        "detalle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total": {
          "type": "number",
          "minimum": -30,
          "maximum": 0
        }
      }
    },
    "puntaje_bruto": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "puntaje_final": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Con estado integridad_comprometida vale 0 por regla, no por aritmetica: la nota queda suspendida y la decide el profesor."
    },
    "nota_10": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "sugerencia_mejora": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "accion",
        "puntos_potenciales"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5"
          ]
        },
        "accion": {
          "type": "string",
          "maxLength": 600,
          "description": "Una sola, concreta, accionable en una semana: qué archivo, qué contenido, qué evidencia falta."
        },
        "puntos_potenciales": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "nota_al_margen": {
      "type": "string",
      "maxLength": 300,
      "description": "Vacio normalmente. Se llena cuando el puntaje es extremo (menor a 40 o mayor a 90) o el estado no es 'evaluado'. Es una anotacion INTERNA para quien corrige, no para el alumno: nunca entra en la devolucion de Moodle."
    },
    "dudas": {
      "type": "array",
      "description": "Toda duda resuelta hacia el nivel menor, y toda limitación de acceso declarada.",
      "items": {
        "type": "string"
      }
    },
    "auditoria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7",
        "A8",
        "A9"
      ],
      "properties": {
        "A1": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A2": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A3": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A4": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A5": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A6": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A7": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A8": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        },
        "A9": {
          "type": "string",
          "enum": [
            "OK",
            "FALLA"
          ]
        }
      }
    },
    "revision_humana_requerida": {
      "type": "boolean"
    },
    "firma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "version_prompt",
        "modelo",
        "temperatura",
        "responsable_humano"
      ],
      "properties": {
        "agente": {
          "type": "string"
        },
        "version_prompt": {
          "type": "string"
        },
        "modelo": {
          "type": "string"
        },
        "temperatura": {
          "type": "number",
          "const": 0
        },
        "responsable_humano": {
          "type": "string",
          "description": "Nombre y rol de la persona que firma el informe. La responsabilidad por el output no se delega."
        }
      }
    }
  }
}
